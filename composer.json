{
    "name": "thesis/symfony-console-module",
    "description": "Thesis Symfony Console Module",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/console": "^8.1",
        "thesis/dic": "^0.5@dev"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.0",
        "testo/assert": "^0.1.9",
        "testo/codecov": "^0.1.11",
        "testo/data": "^0.1.6",
        "testo/test": "^0.1.4",
        "testo/testo": "^0.10.29"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
